{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autor-fynhq@github.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "storage", "webNavigation"],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-black-16.png",
      "32": "icons/icon-black-32.png",
      "48": "icons/icon-black-48.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon-white-16.png",
        "dark": "icons/icon-black-16.png",
        "size": 16
      },
      {
        "light": "icons/icon-white-32.png",
        "dark": "icons/icon-black-32.png",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Ctrl+Alt+R",
        "mac": "MacCtrl+Command+R"
      },
      "description": "__MSG_commandDescription__"
    }
  }
}
